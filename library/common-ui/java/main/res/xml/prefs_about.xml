<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ HyperHand Modded — Pro About Section Layout
  -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <SwitchPreference
        android:key="prefs_key_various_enable_super_function"
        android:layout="@layout/activity_about"
        android:summary="@string/xposed_description"
        app:isPreferenceVisible="false" />

    <!-- DEVICE & ENVIRONMENT INFORMATION -->
    <PreferenceCategory android:title="📱 Device &amp; System Telemetry">

        <Preference
            android:enabled="false"
            android:key="prefs_key_about_device_name"
            android:layout="@layout/preference_big_title"
            android:title="HyperHand Active Host" />

        <Preference
            android:enabled="false"
            android:key="prefs_key_about_device_info_device"
            android:layout="@layout/preference_second_title"
            android:summary="@string/about_device_info_device"
            android:title="Xiaomi / Redmi Host" />

        <Preference
            android:enabled="false"
            android:key="prefs_key_about_device_info_android"
            android:layout="@layout/preference_second_title"
            android:summary="@string/about_device_info_android"
            android:title="Android 15 (API 35)" />

        <Preference
            android:enabled="false"
            android:key="prefs_key_about_device_info_os"
            android:layout="@layout/preference_second_title"
            android:summary="@string/about_device_info_os"
            android:title="HyperOS 2.0" />

        <Preference
            android:enabled="false"
            android:key="prefs_key_about_device_info_padding"
            android:layout="@layout/preference_padding"
            android:title="68D8CAA79216300F9DEE19A24CB6301ABF1687DF" />

    </PreferenceCategory>

    <!-- HYPERHAND MODDED CORE SUITE -->
    <PreferenceCategory android:title="🔮 HyperHand Modded Edition">

        <Preference
            android:enabled="false"
            android:summary="@string/about_modded_desc"
            android:title="@string/about_modded_subtitle" />

        <Preference
            android:summary="@string/about_features_summary"
            android:title="🧪 55+ Experimental Features">
            <intent
                android:action="android.intent.action.VIEW"
                android:data="https://github.com/osphvdhwj/HyperCeiler-Modded#-experimental-features-hyperhand-additions" />
        </Preference>

        <Preference
            android:summary="@string/about_releases_summary"
            android:title="📦 Releases &amp; Build Artifacts">
            <intent
                android:action="android.intent.action.VIEW"
                android:data="https://github.com/osphvdhwj/HyperCeiler-Modded/releases" />
        </Preference>

        <Preference
            android:summary="@string/about_architecture_summary"
            android:title="⚡ Hook Engine &amp; DexKit Runtime" />

    </PreferenceCategory>

    <!-- DEVELOPERS & CONTRIBUTORS -->
    <PreferenceCategory android:title="@string/about_developer_title">

        <Preference
            android:icon="@drawable/ic_sevtinge"
            android:layout="@layout/preference_round_layout"
            android:summary="@string/about_dev_harry_desc"
            android:title="Harry (HyperHand Project)">
            <intent
                android:action="android.intent.action.VIEW"
                android:data="https://github.com/osphvdhwj/HyperCeiler-Modded" />
        </Preference>

        <Preference
            android:icon="@drawable/ic_hyperceiler"
            android:layout="@layout/preference_round_layout"
            android:summary="@string/about_dev_sevtinge_desc"
            android:title="Sevtinge">
            <intent
                android:action="android.intent.action.VIEW"
                android:data="https://github.com/Sevtinge" />
        </Preference>

        <Preference
            android:fragment="com.sevtinge.hyperceiler.ui.page.about.AboutContributerFragment"
            android:key="prefs_key_about_contributer"
            android:title="@string/about_contributer" />

    </PreferenceCategory>

    <!-- COMMUNITY & TELEGRAM -->
    <PreferenceCategory android:title="@string/about_chat_title">

        <Preference
            android:summary="@string/about_telegram_release_summary"
            android:title="@string/about_telegram_release">
            <intent
                android:action="android.intent.action.VIEW"
                android:data="https://t.me/HyperHand_Release" />
        </Preference>

        <Preference
            android:summary="Join the community chat to discuss features &amp; report bugs"
            android:title="@string/about_tg_group">
            <intent
                android:action="android.intent.action.VIEW"
                android:data="https://t.me/HyperHand_Release" />
        </Preference>

    </PreferenceCategory>

    <!-- TRANSLATION & LOCALIZATION -->
    <PreferenceCategory android:title="@string/about_translator_title">

        <Preference
            android:summary="@string/about_crwd_desc"
            android:title="@string/about_crwd">
            <intent
                android:action="android.intent.action.VIEW"
                android:data="https://crowdin.com/project/cemiuiler" />
        </Preference>

    </PreferenceCategory>

    <!-- OPEN SOURCE & RESOURCES -->
    <PreferenceCategory android:title="@string/about_other_title">

        <Preference
            android:summary="@string/about_github_desc"
            android:title="@string/about_github">
            <intent
                android:action="android.intent.action.VIEW"
                android:data="https://github.com/osphvdhwj/HyperCeiler-Modded" />
        </Preference>

        <Preference
            android:fragment="com.sevtinge.hyperceiler.ui.page.about.AboutUseFragment"
            android:key="prefs_key_about_use"
            android:title="@string/about_use" />

        <Preference
            android:summary="@string/about_donation_desc"
            android:title="@string/about_donation">
            <intent
                android:action="android.intent.action.VIEW"
                android:data="https://www.sevtinge.com/donation" />
        </Preference>

        <Preference
            android:fragment="com.sevtinge.hyperceiler.ui.page.settings.helper.HelpFragment"
            android:key="prefs_key_help"
            android:title="@string/help" />

        <Preference android:title="@string/about_protocol">
            <intent
                android:action="android.intent.action.VIEW"
                android:data="https://hyperceiler.sevtinge.com/Protocol" />
        </Preference>

        <Preference android:title="@string/about_privacy">
            <intent
                android:action="android.intent.action.VIEW"
                android:data="https://hyperceiler.sevtinge.com/Privacy" />
        </Preference>

    </PreferenceCategory>

    <PreferenceCategory android:layout="@layout/preference_copyright" />

</PreferenceScreen>
