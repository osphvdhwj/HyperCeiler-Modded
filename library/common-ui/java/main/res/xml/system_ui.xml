<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory>
    <Preference
        android:fragment="com.sevtinge.hyperceiler.ui.hooker.systemui.LockScreenSettings"
        android:title="@string/system_ui_lockscreen_title" />

    <Preference
        android:fragment="com.sevtinge.hyperceiler.ui.hooker.systemui.StatusBarSettings"
        android:title="@string/system_ui_statusbar_title" />

    <Preference
        android:fragment="com.sevtinge.hyperceiler.ui.hooker.systemui.NavigationSettings"
        android:title="@string/system_ui_navigation_title" />

    <Preference
        android:fragment="com.sevtinge.hyperceiler.ui.hooker.systemui.ControlCenterSettings"
        android:title="@string/system_ui_controlcenter_title" />

    <Preference
        android:fragment="com.sevtinge.hyperceiler.ui.hooker.systemui.OtherSettings"
        android:title="@string/system_ui_other_title" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/experiment_category">
        <SwitchPreference
            android:key="experiment_systemui_cc_tile_animation"
            android:title="@string/experiment_systemui_cc_tile_animation"
            android:summary="@string/experiment_systemui_cc_tile_animation_summary"
            android:defaultValue="false" />
        <SwitchPreference
            android:key="experiment_systemui_cc_blur_intensity"
            android:title="@string/experiment_systemui_cc_blur_intensity"
            android:summary="@string/experiment_systemui_cc_blur_intensity_summary"
            android:defaultValue="false" />
        <SwitchPreference
            android:key="experiment_systemui_lockscreen_custom_clock"
            android:title="@string/experiment_systemui_lockscreen_custom_clock"
            android:summary="@string/experiment_systemui_lockscreen_custom_clock_summary"
            android:defaultValue="false" />
    </PreferenceCategory>

</PreferenceScreen>