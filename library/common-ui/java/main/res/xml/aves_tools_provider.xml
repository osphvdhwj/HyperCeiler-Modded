<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:myLocation="@string/aves_tools_provider_title">

    <PreferenceCategory android:title="@string/aves_tools_provider_bridge_title">
        <SwitchPreference
            android:key="prefs_key_aves_bridge_enable"
            android:title="@string/aves_tools_provider_enable"
            android:summary="@string/aves_tools_provider_coming_soon"
            android:defaultValue="false" />

        <Preference
            android:key="prefs_key_aves_bridge_endpoint"
            android:title="@string/aves_tools_provider_endpoint"
            android:summary="content://com.avesplus.tools.provider" />

        <SwitchPreference
            android:key="prefs_key_aves_bridge_fallback_native"
            android:title="@string/aves_tools_provider_fallback_native"
            android:summary="@string/aves_tools_provider_coming_soon"
            android:defaultValue="true" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/aves_tools_provider_tools_title">
        <SwitchPreference android:key="prefs_key_aves_bridge_tools_ocr"
            android:title="OCR"
            android:summary="@string/aves_tools_provider_coming_soon"
            android:defaultValue="true" />
        <SwitchPreference android:key="prefs_key_aves_bridge_tools_nsfw"
            android:title="NSFW scoring"
            android:summary="@string/aves_tools_provider_coming_soon"
            android:defaultValue="true" />
        <SwitchPreference android:key="prefs_key_aves_bridge_tools_tag"
            android:title="Auto-tagging"
            android:summary="@string/aves_tools_provider_coming_soon"
            android:defaultValue="true" />
        <SwitchPreference android:key="prefs_key_aves_bridge_tools_caption"
            android:title="Image captioning"
            android:summary="@string/aves_tools_provider_coming_soon"
            android:defaultValue="true" />
        <SwitchPreference android:key="prefs_key_aves_bridge_tools_search"
            android:title="Semantic search"
            android:summary="@string/aves_tools_provider_coming_soon"
            android:defaultValue="true" />
        <SwitchPreference android:key="prefs_key_aves_bridge_tools_translate"
            android:title="Offline translation"
            android:summary="@string/aves_tools_provider_coming_soon"
            android:defaultValue="true" />
        <SwitchPreference android:key="prefs_key_aves_bridge_tools_embed"
            android:title="Embeddings"
            android:summary="@string/aves_tools_provider_coming_soon"
            android:defaultValue="true" />
    </PreferenceCategory>

</PreferenceScreen>
