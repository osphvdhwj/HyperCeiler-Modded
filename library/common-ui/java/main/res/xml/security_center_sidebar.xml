<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:myLocation="@string/security_center_newbox_title"
    app:quick_restart="com.miui.securitycenter">
    <PreferenceCategory android:title="@string/various_location_simulation_all_title">
        <SwitchPreference
            android:defaultValue="false"
            android:key="prefs_key_security_center_hide_sidebar"
            android:title="@string/security_center_hide_sidebar" />

        <SwitchPreference
            android:defaultValue="false"
            android:dependency="prefs_key_security_center_hide_sidebar"
            android:key="prefs_key_security_center_leave_open"
            android:title="@string/security_center_leave_open" />

        <SwitchPreference
            android:defaultValue="false"
            android:key="prefs_key_security_center_newbox_custom_enable"
            android:title="@string/security_center_newbox_custom_enable" />

        <SwitchPreference
            android:defaultValue="false"
            android:enabled="false"
            android:key="prefs_key_security_center_sidebar_line_color"
            android:title="@string/security_center_sidebar_line_color" />

        <ColorPickerPreference
            android:defaultValue="-1294740525"
            android:dependency="prefs_key_security_center_sidebar_line_color"
            android:key="prefs_key_security_center_sidebar_line_color_default"
            android:title="@string/security_center_sidebar_line_color_default" />

        <ColorPickerPreference
            android:defaultValue="-6842473"
            android:dependency="prefs_key_security_center_sidebar_line_color"
            android:key="prefs_key_security_center_sidebar_line_color_dark"
            android:title="@string/security_center_sidebar_line_color_dark" />

        <ColorPickerPreference
            android:defaultValue="-872415232"
            android:dependency="prefs_key_security_center_sidebar_line_color"
            android:key="prefs_key_security_center_sidebar_line_color_light"
            android:title="@string/security_center_sidebar_line_color_light" />

        <SwitchPreference
            android:defaultValue="false"
            android:key="prefs_key_se_enable"
            android:title="@string/security_center_blur_model" />

        <SwitchPreference
            android:defaultValue="false"
            android:key="prefs_key_security_center_blur_model_super"
            android:dependency="prefs_key_se_enable"
            android:disableDependentsState="true"
            android:title="@string/use_hyper_blur" />

        <SwitchPreference
            android:defaultValue="false"
            android:dependency="prefs_key_se_enable"
            android:key="prefs_key_security_center_invert_color"
            android:summary="@string/security_center_invert_color_summary"
            android:title="@string/security_center_invert_color" />

        <SeekBarPreferenceCompat
            app:defaultValue="60"
            android:dependency="prefs_key_security_center_blur_model_super"
            android:key="prefs_key_security_center_blurradius"
            android:title="@string/security_center_blurradius"
            app:defaultValueTitle="@string/array_default"
            app:format="%d %%"
            app:maxValue="99"
            app:minValue="30"
            app:stepValue="1" />

        <ColorPickerPreference
            android:defaultValue="-1"
            android:dependency="prefs_key_se_enable"
            android:key="prefs_key_security_center_color"
            android:title="@string/security_center_color" />
<SwitchPreference
            android:defaultValue="false"
            android:key="prefs_key_security_center_disable_remove_screen_hold_on"
            android:title="@string/security_center_disable_remove_screen_hold_on" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/security_center_sidebar_videobox_title">
        <!-- Video toolbox unlock features removed: SecurityCenter 8.x no
             longer contains the FRC/MEMC/AIS code they patched. -->
        <SwitchPreference
            android:defaultValue="false"
            android:key="prefs_key_security_center_dolby_open"
            android:title="@string/security_center_dolby_open" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/security_center_sidebar_gamebox_title">
        <SwitchPreference

            android:defaultValue="false"

            android:key="prefs_key_security_center_game_music_capsule"

            android:title="@string/security_center_game_music_capsule"

            android:summary="@string/security_center_game_music_capsule_desc" />

        <SwitchPreference
            android:defaultValue="false"
            android:key="prefs_key_security_center_game_panel_english"
            android:title="Translate game panel to English"
            android:summary="Replace Chinese labels in the game sidebar panel with English" />

        <SwitchPreference

            android:defaultValue="false"

            android:key="prefs_key_security_center_game_performance_wild_mode"
            android:title="@string/security_center_game_performance_wild_mode" />

        <SwitchPreference
            android:defaultValue="false"
            android:key="prefs_key_security_center_remove_macro_black_list"
            android:title="@string/security_center_remove_macro_black_list" />

        <SwitchPreference
            android:defaultValue="false"
            android:key="prefs_key_security_center_unlock_gun_service"
            android:title="@string/security_center_unlock_gun_service" />

        <SwitchPreference
            android:defaultValue="false"
            android:key="prefs_key_security_center_remove_game_toast"
            android:title="@string/security_center_remove_game_toast" />

    </PreferenceCategory>
    <PreferenceCategory android:title="Security app features">
        <SwitchPreference
            android:defaultValue="false"
            android:key="prefs_key_security_center_lock_screen_traffic"
            android:title="Force lock-screen traffic monitor"
            android:summary="Enable the traffic monitor option the ROM gates off" />

        <SwitchPreference
            android:defaultValue="false"
            android:key="prefs_key_security_center_bubble_notification_unlock"
            android:title="Unlock bubble notifications"
            android:summary="Force bubble notification support checks to pass" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Sidebar size (px, 0 = default)">
        <SeekBarPreferenceCompat
            app:defaultValue="0"
            android:max="60"
            android:min="0"
            android:key="prefs_key_security_center_sidebar_line_width"
            android:title="Sidebar line width (px)"
            app:showSeekBarValue="true" />

        <SeekBarPreferenceCompat
            app:defaultValue="0"
            android:max="1600"
            android:min="0"
            android:key="prefs_key_security_center_sidebar_line_length"
            android:title="Sidebar line length (px)"
            app:showSeekBarValue="true" />

        <SeekBarPreferenceCompat
            app:defaultValue="0"
            android:max="800"
            android:min="0"
            android:key="prefs_key_security_center_sidebar_line_margin"
            android:title="Sidebar line edge margin (px)"
            app:showSeekBarValue="true" />

        <SeekBarPreferenceCompat
            app:defaultValue="0"
            android:max="2000"
            android:min="0"
            android:key="prefs_key_security_center_sidebar_assistant_width"
            android:title="Sidebar panel width (px)"
            app:showSeekBarValue="true" />

        <SeekBarPreferenceCompat
            app:defaultValue="0"
            android:max="2600"
            android:min="0"
            android:key="prefs_key_security_center_sidebar_assistant_height"
            android:title="Sidebar panel height (px)"
            app:showSeekBarValue="true" />

        <SeekBarPreferenceCompat
            app:defaultValue="0"
            android:max="2400"
            android:min="0"
            android:key="prefs_key_security_center_sidebar_default_y"
            android:title="Sidebar vertical position Y (px)"
            app:showSeekBarValue="true" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Sidebar colors (-1 = default)">
        <ColorPickerPreference
            android:defaultValue="-1"
            android:key="prefs_key_security_center_sidebar_menu_bg_color"
            android:title="Shortcut menu background" />

        <ColorPickerPreference
            android:defaultValue="-1"
            android:key="prefs_key_security_center_sidebar_wrapper_color"
            android:title="Panel background (dark)" />
    </PreferenceCategory>
</PreferenceScreen>
